#!/bin/sh
# After install: refresh the icon and desktop caches. A running IBus sees the new engine only after a restart, which the
# guide does (Linux/settings/Guide.cpp); one started later (the next login) finds it on its own.
set -e
if command -v gtk-update-icon-cache >/dev/null 2>&1; then gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true; fi
if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database -q /usr/share/applications 2>/dev/null || true; fi
exit 0
