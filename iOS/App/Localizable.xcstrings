    },
    "Hiện các từ gợi ý phía trên bàn phím, cả tiếng Việt lẫn tiếng Anh. Chạm vào một từ để dùng nó.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show suggested words above the keys, in both Vietnamese and English. Tap a word to use it."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện các từ gợi ý phía trên bàn phím, cả tiếng Việt lẫn tiếng Anh. Chạm vào một từ để dùng nó."
          }
